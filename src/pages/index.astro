---
import HomeLayout from '../layouts/HomeLayout.astro';
---

<HomeLayout title="Claude Dev Guide">
  <div class="min-h-screen flex flex-col items-center justify-center px-6 py-16">

    <!-- Site title -->
    <div class="mb-12 text-center">
      <h1 class="text-2xl font-semibold text-prose mb-2">Claude Dev Guide</h1>
      <p class="text-sm text-dim">For developers building side projects with Claude.</p>
    </div>

    <!-- Two-path cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 w-full max-w-2xl">

      <!-- Tutorial card -->
      <a
        href="/tutorial"
        class="group flex flex-col p-6 bg-surface rounded-xl border border-amber/30 hover:border-amber/60 transition-colors"
      >
        <div class="text-[10px] font-semibold tracking-[0.12em] uppercase text-amber mb-4">
          Start the tutorial
        </div>
        <h2 class="text-base font-semibold text-prose mb-3">Tutorial</h2>
        <p class="text-sm text-dim leading-relaxed mb-6 flex-1">
          Build Ab Bekhoor — a Flutter water tracker — from idea to ship,
          introducing Claude Code features as the project needs them.
          8&nbsp;chapters, ~3&nbsp;hours.
        </p>
        <div class="flex items-end justify-between gap-3">
          <span class="text-sm text-amber">Begin Chapter 0 →</span>
          <span class="text-[11px] text-dim text-right leading-snug">New to Claude&nbsp;Code?<br/>Start here.</span>
        </div>
      </a>

      <!-- Reference card -->
      <a
        href="/reference"
        class="group flex flex-col p-6 bg-surface rounded-xl border border-rim hover:border-rim-hi transition-colors"
      >
        <div class="text-[10px] font-semibold tracking-[0.12em] uppercase text-dim mb-4">
          Browse the reference
        </div>
        <h2 class="text-base font-semibold text-prose mb-3">Reference</h2>
        <p class="text-sm text-dim leading-relaxed mb-6 flex-1">
          18 topics across Claude Code, agent craft, and the API.
          Look up specific features, patterns, and pitfalls.
          No order required.
        </p>
        <div class="flex items-end justify-between gap-3">
          <span class="text-sm text-dim group-hover:text-prose transition-colors">Open reference →</span>
          <span class="text-[11px] text-dim text-right leading-snug">Coming back to<br/>look something up?</span>
        </div>
      </a>

    </div>

  </div>
</HomeLayout>
