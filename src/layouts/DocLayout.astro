---
import Sidebar from '../components/Sidebar.astro';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Opinionated field guide to Claude Code, agent guardrailing, and side-project automation.',
} = Astro.props;

const currentPath = Astro.url.pathname;
const mode: 'tutorial' | 'reference' = currentPath.startsWith('/tutorial') ? 'tutorial' : 'reference';
---

<!doctype html>
<html lang="en" class="bg-canvas">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title === 'Claude Dev Guide' ? title : `${title} — Claude Dev Guide`}</title>
  <meta name="description" content={description} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
    rel="stylesheet"
  />
</head>
<body class="bg-canvas text-prose font-sans antialiased">

  <!-- Layout shell -->
  <div class="flex min-h-screen">

    <!-- Sidebar: hidden on mobile, fixed on md+ -->
    <aside
      id="sidebar"
      class="fixed top-0 left-0 h-screen w-60 bg-surface border-r border-rim overflow-y-auto z-40
             -translate-x-full md:translate-x-0 transition-transform duration-200"
      aria-label="Site navigation"
    >
      <!-- Logo / home link -->
      <div class="px-5 py-4 border-b border-rim">
        <a href="/" class="text-[13px] font-semibold text-prose hover:text-amber transition-colors">
          Claude Dev Guide
        </a>
        <p class="text-[11px] text-dim mt-0.5 leading-tight">
          For developers. No fluff.
        </p>
      </div>
      <Sidebar currentPath={currentPath} mode={mode} />
    </aside>

    <!-- Mobile overlay -->
    <div
      id="sidebar-overlay"
      class="fixed inset-0 bg-black/60 z-30 hidden md:hidden"
      aria-hidden="true"
    ></div>

    <!-- Main area -->
    <div class="flex-1 flex flex-col md:ml-60">

      <!-- Mobile top bar -->
      <header class="md:hidden sticky top-0 z-20 flex items-center gap-3 px-4 py-3 bg-surface border-b border-rim">
        <button
          id="hamburger"
          class="text-dim hover:text-prose transition-colors p-1 -ml-1 rounded"
          aria-label="Open navigation"
          aria-expanded="false"
          aria-controls="sidebar"
        >
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
            <path d="M2 4.5h14M2 9h14M2 13.5h14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
        </button>
        <a href="/" class="text-[13px] font-semibold text-prose">Claude Dev Guide</a>
      </header>

      <!-- Page content -->
      <main id="main-content" class="flex-1 px-6 md:px-10 py-8 md:py-10">
        <div class="max-w-content mx-auto">
          <slot />
        </div>
      </main>

    </div>
  </div>

  <script>
    const sidebar = document.getElementById('sidebar')!;
    const overlay = document.getElementById('sidebar-overlay')!;
    const hamburger = document.getElementById('hamburger')!;

    function openSidebar() {
      sidebar.classList.remove('-translate-x-full');
      overlay.classList.remove('hidden');
      hamburger.setAttribute('aria-expanded', 'true');
      hamburger.setAttribute('aria-label', 'Close navigation');
    }

    function closeSidebar() {
      sidebar.classList.add('-translate-x-full');
      overlay.classList.add('hidden');
      hamburger.setAttribute('aria-expanded', 'false');
      hamburger.setAttribute('aria-label', 'Open navigation');
    }

    hamburger.addEventListener('click', () => {
      const isOpen = hamburger.getAttribute('aria-expanded') === 'true';
      isOpen ? closeSidebar() : openSidebar();
    });

    overlay.addEventListener('click', closeSidebar);

    // Close on Escape
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeSidebar();
    });
  </script>

</body>
</html>
