---
import DocLayout from './DocLayout.astro';
import { nav } from '../data/nav';
import { refToChapter } from '../data/tutorial';
import Callout from '../components/Callout.astro';
import PromptBlock from '../components/PromptBlock.astro';
import ArticleStyles from '../components/ArticleStyles.astro';

interface Props {
  title: string;
  tier: 1 | 2 | 3;
  order: number;
  summary: string;
  slug: string;
  collection: 'tier1' | 'tier2' | 'tier3';
}

const { title, tier, order, summary, slug, collection } = Astro.props;

const allItems = nav.flatMap(g => g.items).sort((a, b) => a.order - b.order);
const currentHref = `/reference/${collection}/${slug}`;
const tutorialLink = refToChapter[currentHref] ?? null;
const currentIdx  = allItems.findIndex(i => i.href === currentHref);
const prev = currentIdx > 0 ? allItems[currentIdx - 1] : null;
const next = currentIdx < allItems.length - 1 ? allItems[currentIdx + 1] : null;

const tierBadge = {
  1: 'bg-amber/10 text-amber',
  2: 'bg-blue-500/10 text-blue-400',
  3: 'bg-violet-500/10 text-violet-400',
} as const;

const tierLabel = { 1: 'T1', 2: 'T2', 3: 'T3' } as const;

const groupLabel = {
  tier1: 'Claude Code',
  tier2: 'Agent Craft',
  tier3: 'Claude.ai & API',
} as const;
---

<DocLayout title={title}>

  <!-- Breadcrumb -->
  <nav class="flex items-center gap-1.5 text-xs text-dim mb-6" aria-label="Breadcrumb">
    <a href="/" class="hover:text-prose transition-colors">Home</a>
    <span aria-hidden="true">›</span>
    <a href="/reference" class="hover:text-prose transition-colors">Reference</a>
    <span aria-hidden="true">›</span>
    <span>{groupLabel[collection]}</span>
    <span aria-hidden="true">›</span>
    <span class="text-prose">{title}</span>
  </nav>

  <!-- Tutorial cross-link banner -->
  {tutorialLink && (
    <div class="mb-6 flex items-center gap-2.5 px-3 py-2.5 rounded-lg bg-amber/5 border border-amber/20 text-xs text-dim">
      <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true" class="shrink-0 text-amber/60">
        <path d="M6 1v6M6 10v.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      </svg>
      <span>
        Learning from scratch? This concept is introduced in
        <a href={`/tutorial/${tutorialLink.slug}`} class="text-amber hover:underline font-medium">
          Chapter {tutorialLink.chapter}: {tutorialLink.title} →
        </a>
      </span>
    </div>
  )}

  <!-- Article header -->
  <header class="mb-8 pb-6 border-b border-rim">
    <div class="flex items-center gap-2 mb-3">
      <span class={`text-[10px] font-mono px-1.5 py-0.5 rounded ${tierBadge[tier]}`}>
        {tierLabel[tier]}
      </span>
      <span class="text-xs text-dim">{groupLabel[collection]}</span>
    </div>
    <h1 class="text-lg font-semibold text-prose mb-2">{title}</h1>
    <p class="text-sm text-dim leading-relaxed">{summary}</p>
  </header>

  <!-- Article body -->
  <article class="article">
    <slot />
  </article>

  <!-- Prev / Next navigation -->
  {(prev || next) && (
    <nav class="flex items-center justify-between gap-4 mt-12 pt-6 border-t border-rim" aria-label="Topic navigation">
      {prev ? (
        <a href={prev.href} class="group flex flex-col gap-0.5 min-w-0">
          <span class="text-[10px] text-dim uppercase tracking-widest">Previous</span>
          <span class="text-sm text-dim group-hover:text-amber transition-colors truncate">← {prev.title}</span>
        </a>
      ) : <div />}
      {next ? (
        <a href={next.href} class="group flex flex-col gap-0.5 min-w-0 items-end text-right">
          <span class="text-[10px] text-dim uppercase tracking-widest">Next</span>
          <span class="text-sm text-dim group-hover:text-amber transition-colors truncate">{next.title} →</span>
        </a>
      ) : <div />}
    </nav>
  )}

</DocLayout>

<ArticleStyles />

<script>
  document.querySelectorAll('.article pre.astro-code').forEach(pre => {
    const btn = document.createElement('button');
    btn.className = 'copy-btn';
    btn.textContent = 'copy';
    btn.setAttribute('aria-label', 'Copy code to clipboard');
    pre.appendChild(btn);
    btn.addEventListener('click', () => {
      const text = (pre.querySelector('code')?.textContent ?? pre.textContent ?? '').trimEnd();
      navigator.clipboard.writeText(text).then(() => {
        btn.textContent = 'copied';
        setTimeout(() => { btn.textContent = 'copy'; }, 1800);
      });
    });
  });
</script>
